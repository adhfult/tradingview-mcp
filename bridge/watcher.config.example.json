{
  "timezone": "America/New_York",
  "watchlist": [
    {"symbol": "BINANCE:BTCUSDT", "timeframes": ["15", "60", "240"]},
    {"symbol": "BINANCE:ETHUSDT", "timeframes": ["60", "240"]},
    {"symbol": "NASDAQ:NVDA", "timeframes": ["15", "D"], "market": "stock"}
  ],
  "rules": [
    {"id": "move", "type": "pct_move", "bars": 4, "threshold_pct": 3, "max_per_day": 10},
    {"id": "volspike", "type": "volume_spike", "multiple": 3, "lookback": 20, "timeframes": ["15"], "calendar": "us_session"},
    {"id": "rsi", "type": "rsi_cross", "period": 14, "levels": [30, 70]},
    {"id": "bb", "type": "bollinger_break", "period": 20, "stddev": 2},
    {"id": "breakout", "type": "new_extreme", "lookback": 50},
    {"id": "rsi-volume", "type": "all_of", "rules": ["rsi", "volspike"], "timeframes": ["15"]},
    {"id": "btc100k", "type": "price_cross", "symbol": "BINANCE:BTCUSDT", "level": 100000}
  ],
  "trending": {
    "enabled": true,
    "every_minutes": 10,
    "markets": ["crypto", "america"],
    "kinds": ["gainers", "volumeGainers"],
    "top_n": 15,
    "us_regular_hours_only": true,
    "remember_hours": 6
  },
  "news": {
    "enabled": false,
    "every_minutes": 30,
    "remember_hours": 72,
    "max_age_minutes": 120,
    "max_items_per_digest": 10,
    "sources": {"tradingview": true, "sec": true},
    "tickers_extra": [],
    "include_keywords": [],
    "exclude_keywords": [],
    "sec_forms": ["8-K", "10-Q", "10-K"]
  },
  "alerts": {
    "cooldown_minutes": 60,
    "max_per_hour": 20,
    "quiet_hours": {"start": "23:00", "end": "07:00"},
    "digest_after_quiet": true
  },
  "health": {"stream_down_minutes": 10, "daily_heartbeat": "08:00"},
  "state_dir": "~/.local/state/tradingview-watcher",
  "local_api": {"enabled": true, "port": 8787},
  "dashboard": {"enabled": true, "host": "127.0.0.1", "port": 8788,
    "notes": {"enabled": false, "dir": "~/notes/markets", "vault": "ObsidianVault", "vault_folder": "markets"}},
  "images": {"enabled": false, "chromium_path": "", "max_per_hour": 6, "timeout_ms": 10000},
  "limits": {"max_streams": 25}
