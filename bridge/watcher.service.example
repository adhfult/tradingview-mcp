# systemd unit for the market watcher (Raspberry Pi OS, user pi).
# Install: sudo cp bridge/watcher.service.example /etc/systemd/system/tradingview-watcher.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now tradingview-watcher
# Logs:    journalctl -u tradingview-watcher -f
[Unit]
Description=TradingView market watcher (alerts only, never trades)
# A Pi has no battery clock: wait for the time sync, or cooldowns and quiet hours start from a wrong time.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
User=pi
WorkingDirectory=/home/pi/code/tradingview-mcp
EnvironmentFile=/etc/tradingview-watcher.env
ExecStart=/usr/bin/node bridge/watcher.mjs --config /home/pi/.config/tradingview-watcher/config.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# This directory must exist before the service starts (mkdir -p ~/.local/state/tradingview-watcher).
ReadWritePaths=/home/pi/.local/state/tradingview-watcher
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
