# Copy to /etc/tradingview-watcher.env and run: chmod 600 /etc/tradingview-watcher.env
# Names only. Leave a value empty to disable that feature.
TRADINGVIEW_SESSION_ID=
TRADINGVIEW_SESSION_SIGN=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHER_LOCAL_TOKEN=
WATCHER_DASHBOARD_TOKEN=
# News (news.enabled in the config). Set the contact with: bash scripts/pi-setup.sh --sec-contact
WATCHER_SEC_CONTACT=
FINNHUB_API_KEY=
# Not a secret: path of the browser for chart images (images.enabled in the config), for example /usr/bin/chromium
WATCHER_CHROMIUM_PATH=
